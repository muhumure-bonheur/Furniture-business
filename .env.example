# Required: the website loads published content from this Sanity project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only token with write permission. Used only by the temporary sample seed script.
SANITY_API_WRITE_TOKEN=

# Telephone and WhatsApp numbers are managed in Sanity > Site settings > Contact details.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
